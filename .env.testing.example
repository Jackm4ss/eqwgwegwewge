# Testing template
# Use this only when you want a dedicated `.env.testing`.
# Most developers do not need to edit this file often.

# App
APP_NAME="Event System"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Runtime
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Database
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Mail
MAIL_MAILER=log

# Firebase / Firestore
# Keep REST in testing for simplicity.
FIREBASE_TRANSPORT=rest
FIREBASE_API_BASE_URL=https://firestore.googleapis.com/v1
FIREBASE_TIMEOUT_SECONDS=30
FIREBASE_PROJECT_ID=test-project
FIREBASE_CREDENTIALS=storage/app/secrets/firebase-credentials.testing.json
FIREBASE_DATABASE=(default)

# This prefix keeps test data isolated.
FIREBASE_COLLECTION_PREFIX=testing_
FIREBASE_USERS_COLLECTION=
FIREBASE_TICKETS_COLLECTION=
FIREBASE_USER_EMAIL_INDEX_COLLECTION=
FIREBASE_USER_IDENTITY_INDEX_COLLECTION=
FIREBASE_FALLBACK_LOCAL=false

# Event
EVENT_CODE=SONGKRAN2026
