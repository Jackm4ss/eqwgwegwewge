# ==================================================
# START HERE
# ==================================================
# 1. Copy this file to `.env`
# 2. Fill only the values marked "CHANGE THIS"
# 3. If you are using Laragon, `APP_URL` can be your local vhost
#
# - APP_URL
# - FIREBASE_PROJECT_ID
# - FIREBASE_CREDENTIALS
# - FIREBASE_COLLECTION_PREFIX
# - then seed admins with: php artisan admin:seed --password=YOUR_PASSWORD

# App
APP_NAME="Event System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://event-system.test
APP_ROUTING_MODE=path
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
# This project currently uses SQLite for simple local bootstrapping.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# State
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=event_system_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_CONNECTION=default

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
REGISTRATION_REDIS_MODE=disabled
REGISTRATION_EMAIL_QUEUE=registration-emails

# Redis
# Local profile does not require Redis. Leave these defaults as-is unless you
# deliberately want to test the production queue/cache profile on your machine.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE=default

# Mail
# Safe default for local work: write emails to log instead of sending them.
# Change to `smtp` only if you really want to test actual email delivery.
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="no-reply@eventsystem.local"
MAIL_FROM_NAME="${APP_NAME}"

# Bot protection
# Keep this `false` in local development unless you are testing captcha.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Firebase / Firestore
# Local on Windows/Laragon should use REST.
# Production can switch to grpc later.
FIREBASE_TRANSPORT=rest
FIREBASE_API_BASE_URL=https://firestore.googleapis.com/v1
FIREBASE_TIMEOUT_SECONDS=30

# CHANGE THIS: your shared Firebase / GCP project id
FIREBASE_PROJECT_ID=

# CHANGE THIS: put the service-account JSON in `storage/app/secrets/`
# Example: storage/app/secrets/firebase-credentials.json
FIREBASE_CREDENTIALS=storage/app/secrets/firebase-credentials.json
FIREBASE_DATABASE=(default)

# CHANGE THIS: use your own name so your local data does not collide
# with other developers in the same Firebase project.
# Example: local_rina_ / local_budi_ / local_intern1_
FIREBASE_COLLECTION_PREFIX=local_yourname_

# Optional:
# Leave these blank to auto-use:
# - {FIREBASE_COLLECTION_PREFIX}users
# - {FIREBASE_COLLECTION_PREFIX}tickets
# - {FIREBASE_COLLECTION_PREFIX}user_email_index
# - {FIREBASE_COLLECTION_PREFIX}user_identity_index
# - {FIREBASE_COLLECTION_PREFIX}scan_logs
# - {FIREBASE_COLLECTION_PREFIX}admin_activity_logs
FIREBASE_USERS_COLLECTION=
FIREBASE_TICKETS_COLLECTION=
FIREBASE_USER_EMAIL_INDEX_COLLECTION=
FIREBASE_USER_IDENTITY_INDEX_COLLECTION=
FIREBASE_SCAN_LOGS_COLLECTION=
FIREBASE_ADMIN_ACTIVITY_LOGS_COLLECTION=
FIREBASE_FALLBACK_LOCAL=false

# Event
# Usually no need to change this in local development.
EVENT_CODE=SONGKRAN2026
EVENT_TIMEZONE=Asia/Kuala_Lumpur
EVENT_START_DATE=2026-04-09
EVENT_END_DATE=2026-04-19
TICKET_DOWNLOAD_FONT_PATH=storage/app/fonts/TiltWarp-Regular-VariableFont_XROT,YROT.ttf

# Admin panel / local-first routing
# Preferred local admin setup:
# php artisan admin:seed --password=YOUR_PASSWORD
# You can leave ADMIN_BOOTSTRAP_PASSWORD empty and pass the password via command.
BOOTSTRAP_EMAIL_DOMAIN=songkran.local
ADMIN_PANEL_PATH=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SEED_COUNT=8
SCANNER_BOOTSTRAP_PASSWORD=
SCANNER_SEED_COUNT=1
ADMIN_BACKUP_DISK=admin_backups
ADMIN_BACKUP_PATH=admin-backups
ADMIN_BACKUP_GCS_BUCKET=
ADMIN_BACKUP_GCS_PREFIX=event-system
ADMIN_USER_MANAGEMENT_READ_MODEL_ENABLED=false
ADMIN_USER_MANAGEMENT_SYNC_SLA_SECONDS=15
ADMIN_USER_MANAGEMENT_DEGRADED_AFTER_SECONDS=60
ADMIN_USER_MANAGEMENT_FALLBACK_AFTER_SECONDS=300
ADMIN_USER_MANAGEMENT_QUEUE_CONNECTION=${QUEUE_CONNECTION}
ADMIN_USER_MANAGEMENT_SYNC_QUEUE=admin-sync-high
ADMIN_USER_MANAGEMENT_REBUILD_QUEUE=admin-sync-low
ADMIN_USER_MANAGEMENT_RECONCILE_MINUTES=15

# Future production seam
ADMIN_APP_URL=
REGISTER_APP_URL=
STAFF_APP_URL=

# Frontend / routing
REGISTER_SUBDOMAIN=
FRONTEND_HOMEPAGE_URL=http://event-system.test
