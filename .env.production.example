# Production template
# This file is only a reference. Do not commit real production secrets.

# App
APP_NAME="Event System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://songkranfestival.my
APP_ROUTING_MODE=subdomain
APP_TIMEZONE=Asia/Kuala_Lumpur

# Runtime
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.songkranfestival.my

# Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase / Firestore
# Production can use grpc when the server environment supports it.
FIREBASE_TRANSPORT=grpc
FIREBASE_API_BASE_URL=https://firestore.googleapis.com/v1
FIREBASE_TIMEOUT_SECONDS=30
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/secrets/firebase-credentials.production.json
FIREBASE_DATABASE=(default)

# Keep production data in its own namespace.
FIREBASE_COLLECTION_PREFIX=prod_
FIREBASE_USERS_COLLECTION=
FIREBASE_TICKETS_COLLECTION=
FIREBASE_USER_EMAIL_INDEX_COLLECTION=
FIREBASE_USER_IDENTITY_INDEX_COLLECTION=
FIREBASE_FALLBACK_LOCAL=false

# Event
EVENT_CODE=SONGKRAN2026
EVENT_TIMEZONE=Asia/Kuala_Lumpur
EVENT_START_DATE=2026-04-09
EVENT_END_DATE=2026-04-19

# Frontend / routing
ADMIN_APP_URL=https://portal.songkranfestival.my
REGISTER_APP_URL=https://register.songkranfestival.my
STAFF_APP_URL=https://app.songkranfestival.my
REGISTER_SUBDOMAIN=
FRONTEND_HOMEPAGE_URL=https://songkranfestival.my
